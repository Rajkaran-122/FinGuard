# FinGuard Environment Configuration
# Copy this file to .env and update values as needed.

# Database
# SQLite: sqlite:///./finance.db
# PostgreSQL: postgresql://finance_user:finance_password@localhost:5432/finance_db
DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_db

# JWT
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=300

# Application
ENVIRONMENT=development
APP_TITLE=FinGuard API
APP_VERSION=1.0.0

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
