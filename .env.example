# FinGuard Environment Configuration
# Copy this file to .env and fill in the values

# Database URL — SQLite for local dev, PostgreSQL for production
# SQLite: sqlite:///./finance.db
# PostgreSQL: postgresql://user:password@localhost:5432/finguard
DATABASE_URL=postgresql://finance_user:finance_password@localhost:5432/finance_db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Application
ENVIRONMENT=development
APP_TITLE=FinGuard API
APP_VERSION=1.0.0

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
